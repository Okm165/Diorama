# The venue harness's host surface: what the consumer harness sources.
#
# `make apply` renders this into the `test-endpoints` ConfigMap (the derived
# chain id and the `127.0.0.1` host come from the manifests), and
# `make port-forward` opens exactly these loopback forwards.
#
# The services are ClusterIP except venue-sim's info listener, which is the one
# intentional NodePort 31090 (`venue-sim-nodeport`); the rest stay ClusterIP, so
# the Anvil cheatcode set and the venue's `/admin/*` and `/control/*` (deal,
# crash, epoch_new, relay) never bind a host interface.
FORWARD_ANVIL_V=31545:8545
FORWARD_ENGINE=31880:8080
FORWARD_VENUE_SIM=31090:8090 31091:8091
