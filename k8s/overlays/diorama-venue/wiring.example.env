# The Venue Mirror's runtime wiring: the env the instance TOML references as
# ${...}. This file is the tracked template; `make config-bootstrap` copies it
# to `wiring.env` (gitignored), which the overlay turns into the
# `diorama-config` ConfigMap. The hash suffix rolls the pods when a value
# changes.
#
# Every value here is machine/operator specific. The defaults are what a fresh
# clone needs to boot; a deployment overrides them in its own `wiring.env`.
# Operational tunables (intervals, windows, budgets) are NOT here — they live
# in config/instances/*.toml.

# The archive source anvil-v forks from. Anvil forks at a byte-exact block and
# then materializes historical account state on demand, so this endpoint must
# be archive-deep *at the deployment's fork pin*. A fresh deployment resolves
# the source's own head (no pin), which any provider serves; a deployment that
# pins a block (the live instance does, in its untracked specialization.toml)
# needs an archive provider here — the keyed ZAN endpoint is the measured one:
#   https://api.zan.top/node/v1/hyperliquid/mainnet/<KEY>/evm
# Keep keys in this gitignored file, never in a tracked manifest.
EVM_FORK_URL=https://rpc.hyperliquid.xyz/evm

# The market plane's REST and WS endpoints (the `@hyperliquid_info` /
# `@hyperliquid_ws` groups). A keyed mirror (e.g. ZAN's /info) is added as the
# first entry of the live specialization's `[endpoints.hyperliquid_info]`
# group; this variable is the public failover.
HL_INFO_API_URL=https://api.hyperliquid.xyz
HL_WS_API_URL=wss://api.hyperliquid.xyz/ws

# In-namespace service DNS: the fork-mode anvil V and the engine's admin API.
TARGET_RPC_URL=http://anvil-v:8545
ENGINE_ADMIN_URL=http://engine:8080

# The Ethereum anvil the CCTP bridge burns on lives in the mainnet namespace
# (a venue has no T of its own). The bridge instance is separate; this value
# is here because the venue's environment block is complete for its consumers.
T_RPC_URL=http://anvil-t.diorama-mainnet.svc.cluster.local:8545

# State roots on the pods' own PVCs (paths, not claims).
STATE_DIR=/state
SIM_STATE_DIR=/state
CCTP_STATE_DIR=/state
