# The Venue Mirror's runtime wiring: the env the instance TOML references as
# ${...}. This file is the tracked template; `make config-bootstrap` copies it
# to `wiring.env` (gitignored), which the overlay turns into the
# `diorama-config` ConfigMap. The hash suffix rolls the pods when a value
# changes.
#
# Every value here is machine/operator specific. The defaults are what a fresh
# clone needs to boot; a deployment overrides them in its own `wiring.env`.
# Operational tunables (intervals, windows, budgets) are NOT here — they live
# in config/instances/*.toml.

# The keyless fork source anvil-v forks from. Anvil forks at a byte-exact
# block and then materializes historical account state on demand; a deployment
# that pins a block needs an archive-deep (usually keyed) provider instead:
# the keyed URL travels in the instance's `secrets.env` (Secret, never a
# ConfigMap), and shadows this value in the pods that read it.
EVM_FORK_URL=https://rpc.hyperliquid.xyz/evm

# The market plane's public REST and WS endpoints (the `@hyperliquid_info` /
# `@hyperliquid_ws` groups). A keyed /info mirror (e.g. ZAN's) is the
# deployment's `secrets.env` HL_INFO_API_URL, which shadows this public value
# in the pod that reads it.
HL_INFO_API_URL=https://api.hyperliquid.xyz
HL_WS_API_URL=wss://api.hyperliquid.xyz/ws

# In-namespace service DNS: the fork-mode anvil V and the engine's admin API.
TARGET_RPC_URL=http://anvil-v:8545
ENGINE_ADMIN_URL=http://engine:8080

# State roots on the pods' own PVCs (paths, not claims).
STATE_DIR=/state
SIM_STATE_DIR=/state

# The claim class every PVC of this instance requests. `make up` creates the
# default class (Retain: deleting a claim never deletes its volume); a cluster
# with its own provisioner names it here. Change only on an empty cluster:
# a bound claim's class does not rebind.
STORAGE_CLASS=mirror-retain
