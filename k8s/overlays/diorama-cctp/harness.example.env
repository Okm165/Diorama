# The CCTP bridge's host surface: what the consumer harness sources.
#
# `make apply` renders this into the `cctp-test-endpoints` ConfigMap (the Iris
# base is in-cluster DNS for a client in another namespace; the host reaches it
# by the loopback forward below), and `make port-forward` opens the forward.
#
# The services are ClusterIP twins, not NodePorts: the control API can burn the
# relay wallet and re-arm parked messages; it must not be LAN-reachable.
FORWARD_CCTP_BRIDGE=31095:8095 31096:8096
