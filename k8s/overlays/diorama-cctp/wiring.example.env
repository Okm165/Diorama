# The CCTP bridge's runtime wiring: the env its instance TOML references as
# ${...}. This file is the tracked template; `make config-bootstrap` copies it
# to `wiring.env` (gitignored), which the overlay turns into the
# `cctp-config` ConfigMap. The hash suffix rolls the pod when a value changes.
#
# A bridge reaches the two mirror chains cross-namespace, so it needs both
# mirror namespaces reachable (or its own RPC providers — override here).
# Operational tunables live in config/instances/diorama-cctp/*.toml.

# State root on the bridge pod's own PVC (a path, not a claim).
CCTP_STATE_DIR=/state

# The two chains: T (Ethereum, CCTP domain 0) and V (HyperEVM, domain 19).
T_RPC_URL=http://anvil-t.diorama-mainnet.svc.cluster.local:8545
TARGET_RPC_URL=http://anvil-v.diorama-venue.svc.cluster.local:8545

# The funded relay wallet's hex key is a Secret, never a manifest literal:
#   make cctp-secrets CCTP_RELAY_KEY=0x…
