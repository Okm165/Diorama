# The mainnet harness's host surface: what the consumer harness sources.
#
# `make apply` renders this into the `test-endpoints` ConfigMap (the derived
# chain id and the `127.0.0.1` host come from the manifests), and
# `make port-forward` opens exactly these loopback forwards.
#
# The services are ClusterIP twins, not NodePorts: a NodePort binds every host
# interface and exposes the Anvil cheatcode set (`anvil_setBalance`,
# `anvil_setCode`, `eth_sendTransaction` from unlocked accounts) and the
# engine's `/admin/*` (deal, shadow, epoch, time, rewind) to the LAN.
FORWARD_ANVIL_T=30545:8545
FORWARD_ENGINE=30880:8080
