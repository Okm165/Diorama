# The Mainnet Mirror's runtime wiring: the env the instance TOML references as
# ${...}. This file is the tracked template; `make config-bootstrap` copies it
# to `wiring.env` (gitignored), which the overlay turns into the
# `diorama-config` ConfigMap. The hash suffix rolls the pods when a value
# changes.
#
# The defaults are the local reth + lighthouse topology a fresh clone boots
# with; every value is an operator override point.

# The local fork source (reth). Never point this at a remote endpoint in
# production mode: remote mining is 55-256 s/block (measured).
EVM_URL=http://reth:8545

# The chain endpoint the engine drives, plus the beacon/engine-api/JWT wiring
# for the top-up loop (EIP-8379). The fork offset's single home is
# [chains.l1].fork_offset in the instance file - the anvil pod reads it from
# the mounted TOML, so it is not repeated here.
TARGET_RPC_URL=http://anvil-t:8545
BEACON_URL=http://lighthouse:5052
ENGINE_API_URL=http://reth:8551
JWT_PATH=/secrets/jwt.hex
STATE_DIR=/state

# Lighthouse checkpoint sync (fresh CL head without genesis sync). One URL:
# lighthouse takes no fallback argument, so a dead provider is an operator
# switch of this value (beaconcha.in's sync endpoint is the known-good
# alternative - OPERATIONS, "sync stuck").
CHECKPOINT_SYNC_URL=https://mainnet-checkpoint-sync.stakely.io

# The chain-state source (`make snapshot`): the reth snapshot a fresh reth
# starts from. Leave it empty and reth proposes its own newest mainnet
# snapshot (https://snapshots.reth.rs); a mirror on a slow or offline link
# names a snapshot URL (https://….tar.lz4 / .tar.zst) or a `file:///path`
# staged on the node. This is the only part of a fresh mainnet deploy measured
# in hours (165 GB compressed / ~287 GB on disk, resumable).
SNAPSHOT_URL=

# The claim class every PVC of this instance requests. `make up` creates the
# default class (Retain: deleting a claim never deletes its volume); a cluster
# with its own provisioner names it here. Change only on an empty cluster:
# a bound claim's class does not rebind.
STORAGE_CLASS=mirror-retain
