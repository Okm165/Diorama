# Rust build artifacts
/target/
**/target/

# Local scratch
*.tar
*.log

# Per-deployment project specialization. The tracked template is
# `config/instances/*/specialization.example.toml`; the live file is deployment data
# - the ONLY per-deployment config source (hardcoded values, gitignored so
# keyed endpoints and wallet keys never enter git).
config/instances/*/specialization.toml

# The host harness surface (the operator's loopback forwards; no pod reads it)
k8s/overlays/*/harness.env

# Never commit secret material (the reth JWT is generated by `make secrets`)
k8s/**/secret-*.yaml

.context/
# Python bytecode
__pycache__/
*.pyc
