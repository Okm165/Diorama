# Rust build artifacts
/target/
**/target/

# Local scratch
*.tar
*.log

# Per-deployment project specialization. The tracked template is
# `config/instances/*/specialization.example.toml`; the live file is deployment data.
config/instances/*/specialization.toml

# Per-deployment cluster wiring (fork source, mirror endpoints, service DNS)
# and the keyed values (secrets.env: provider keys, wallet keys - the
# instance Secret's source; `make secrets` reads it).
# The tracked templates are `k8s/overlays/*/{wiring,harness,secrets}.example.env`.
k8s/overlays/*/wiring.env
k8s/overlays/*/secrets.env
k8s/overlays/*/harness.env

# Never commit secret material (the reth JWT is generated by `make secrets`)
k8s/**/secret-*.yaml

.context/
# Python bytecode
__pycache__/
*.pyc
